    "GPIO12": { "name": "GPIO12", "label": "Buzzer (fixed)", "inputOnly": false, "interfaces": ["DIGITAL_OUT", "PWM"] },

    "GPIO18": { "name": "GPIO18", "label": "M1 IN1 (fixed)", "inputOnly": false, "interfaces": ["DIGITAL_OUT", "PWM"] },
